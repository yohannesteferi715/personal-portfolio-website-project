# EmailJS Configuration (for Contact form direct delivery)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Backend API Base URL (for production builds on Vercel/Netlify, e.g. https://yoni-portfolio-api.onrender.com)
VITE_API_BASE_URL=https://yoni-portfolio-api.onrender.com

# Backend API Proxy Target (for local Vite dev server, defaults to https://yoni-portfolio-api.onrender.com)
VITE_API_PROXY_TARGET=https://yoni-portfolio-api.onrender.com

# Private Admin Dashboard Route (set your own secret unguessable path)
VITE_ADMIN_BASE_PATH=/admin/your-secret-admin-path

# Supabase Cloud Storage (optional, falls back to local disk storage if empty)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=bucket_portiolio
