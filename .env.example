# EmailJS Configuration (for Contact form direct delivery)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Backend API Proxy Target (optional, defaults to http://127.0.0.1:8001)
VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Private Admin Dashboard Route (set your own secret unguessable path)
VITE_ADMIN_BASE_PATH=/admin/your-secret-admin-path
