# ── Production Environment Configuration Example ────────────────────────────
# Copy this file to backend/.env and update values for your production server.

# Database:
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/portfolio_db
# For local development SQLite:
DATABASE_URL=sqlite:///portfolio.db

# Security & JWT Token Generation (generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Setup (used only to seed the initial admin account on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Allowed CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","https://yourdomain.com"]

# Debug Mode (False in production)
DEBUG=False
